{
  "name": "clearpath",
  "private": true,
  "version": "1.4.0",
  "description": "Care coordination and operations platform: referrals, pathways, prior authorizations, capacity and staffing.",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build --workspaces --if-present",
    "test": "jest",
    "test:cov": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "format": "prettier --write \"{apps,packages,scripts}/**/*.{ts,tsx,js,json}\"",
    "check-env": "node scripts/check-env.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "openapi": "node scripts/generate-openapi.js"
  },
  "prisma": { "seed": "ts-node prisma/seed.ts" },
  "devDependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "pg": "^8.11.5",
    "@types/jest": "^29.5.12",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.11.5",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "prisma": "^5.14.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
