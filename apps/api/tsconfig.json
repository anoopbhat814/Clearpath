{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "incremental": true,
    "sourceMap": true,
    "declaration": false,
    "paths": {
      "@clearpath/shared-types": ["../../packages/shared-types/src"],
      "@clearpath/shared-utils": ["../../packages/shared-utils/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
