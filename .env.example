# --- Core ---
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# --- Data stores ---
DATABASE_URL=postgresql://clearpath:clearpath@localhost:5432/clearpath?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=14
BCRYPT_ROUNDS=12

# --- Side services ---
ANALYTICS_URL=http://localhost:8100
AUDIT_GATEWAY_URL=http://localhost:8200
AUDIT_GATEWAY_SIGNING_KEY=change-me-gateway-hmac-key
AUDIT_GATEWAY_PORT=8200

# --- Worker / notifications ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=care-ops@clearpath.example
REMINDER_LEAD_HOURS=48
AUTH_EXPIRY_WARNING_DAYS=7
CAPACITY_SNAPSHOT_CRON=*/15 * * * *

# --- Observability ---
LOG_LEVEL=info
