{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@clearpath/shared-types": ["packages/shared-types/src"],
      "@clearpath/shared-utils": ["packages/shared-utils/src"],
      "@clearpath/ui": ["packages/ui/src"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", "services"]
}
